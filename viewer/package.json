{
  "name": "uttu-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "next lint",
    "test:auth": "node --test tests/auth.test.cjs tests/auth-admin-password.test.cjs tests/auth-admin-ssr.test.cjs",
    "test:egress": "node --experimental-strip-types src/lib/mcp/anthropic-egress.test.mts",
    "test:auth:admin": "node --test tests/auth-admin-password.test.cjs tests/auth-admin-ssr.test.cjs",
    "test:teams": "node --test tests/teams-*.test.cjs",
    "test:onboarding": "node --test tests/onboarding*.test.cjs",
    "test:ai-session": "node --test tests/ai-session-access.test.cjs tests/ai-usage-accounting.test.cjs",
    "test:ratings": "node --test tests/rating-format.test.cjs",
    "test:reviews-mobile": "node --test tests/mobile-reviews-*.test.cjs",
    "test:recommend-mobile": "node --test --unhandled-rejections=strict tests/mobile-recommend-*.test.cjs",
    "test:review-stats": "node --test tests/review-stats-*.test.cjs tests/cs-anomaly-reviews*.test.cjs",
    "test:review-panels": "node --test tests/review-dashboard-panels*.test.cjs",
    "test:matching": "node --test --unhandled-rejections=strict tests/matching-score.test.cjs tests/competitor-brand-fetch.test.cjs tests/matching-safety.test.cjs tests/matching-ui-safety.test.cjs tests/matching-sdk-http.test.cjs tests/integrated-reader-boundaries.test.cjs",
    "test:collection-status": "node --test tests/collection-status.test.cjs",
    "test:funding-viewer": "node --test --test-concurrency=1 --unhandled-rejections=strict tests/funding-viewer.test.cjs tests/funding-read-deadline.test.cjs",
    "test:magazine-viewer": "node --test --test-concurrency=1 --unhandled-rejections=strict tests/magazine-read-state.test.cjs",
    "test:briefing-evidence": "node --test --test-concurrency=1 --unhandled-rejections=strict tests/briefing-evidence.test.cjs tests/briefing-read-state.test.cjs tests/cs-daily-review-*.test.cjs tests/briefing-kpi.test.cjs",
    "test:briefing-navigation": "node --test tests/briefing-navigation.test.cjs tests/briefing-anomaly-date.test.cjs",
    "test:weekly-reviews": "node --test tests/weekly-review*.test.cjs",
    "test:framework": "node --test tests/framework-migration.test.cjs tests/help-route.test.cjs",
    "test:ranking-daily": "node --test tests/ranking-daily-insights*.test.cjs",
    "test:product-category": "node --test --unhandled-rejections=strict tests/product-category-*.test.cjs",
    "test:performance": "node --test --test-concurrency=1 --unhandled-rejections=strict tests/performance-*.test.cjs",
    "test:report-evidence": "node --test tests/report-*-evidence.test.cjs tests/report-responsive-owner.test.cjs",
    "test:briefing-kpi": "node --test --test-concurrency=1 --unhandled-rejections=strict tests/briefing-kpi.test.cjs tests/briefing-read-state.test.cjs",
    "test:home-ranking": "node --test --unhandled-rejections=strict tests/home-ranking-*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.10.3",
