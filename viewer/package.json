{
  "name": "uttu-viewer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "next lint",
    "test:auth": "node --test tests/auth.test.cjs tests/auth-admin-password.test.cjs tests/auth-admin-ssr.test.cjs",
    "test:egress": "node --experimental-strip-types src/lib/mcp/anthropic-egress.test.mts",
    "test:auth:admin": "node --test tests/auth-admin-password.test.cjs tests/auth-admin-ssr.test.cjs",
    "test:teams": "node --test tests/teams-*.test.cjs",
    "test:onboarding": "node --test tests/onboarding*.test.cjs",
    "test:ai-session": "node --test tests/ai-session-access.test.cjs",
    "test:ratings": "node --test tests/rating-format.test.cjs",
    "test:matching": "node --test tests/matching-score.test.cjs",
    "test:collection-status": "node --test tests/collection-status.test.cjs",
    "test:briefing-evidence": "node --test tests/briefing-evidence.test.cjs",
    "test:briefing-navigation": "node --test tests/briefing-navigation.test.cjs",
    "test:weekly-reviews": "node --test tests/weekly-review*.test.cjs",
    "test:performance": "node --test --test-concurrency=1 --unhandled-rejections=strict tests/performance-*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.0",
    "@tiptap/extension-code-block-lowlight": "^2.0.0",
    "@tiptap/extension-image": "^2.0.0",
    "@tiptap/extension-link": "^2.0.0",
    "@tiptap/extension-placeholder": "^2.0.0",
    "@tiptap/extension-table": "^2.0.0",
    "@tiptap/extension-table-cell": "^2.0.0",
    "@tiptap/extension-table-header": "^2.0.0",
    "@tiptap/extension-table-row": "^2.0.0",
    "@tiptap/extension-task-item": "^2.0.0",
    "@tiptap/extension-task-list": "^2.0.0",
    "@tiptap/pm": "^2.0.0",
    "@tiptap/react": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0",
    "exceljs": "^4.4.0",
    "lowlight": "^3.1.0",
    "mcp-handler": "^1.1.0",
    "next": "^14.2.35",
    "openai": "^6.39.0",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "typescript": "^5",
    "react-test-renderer": "18.3.1"
  }
}
