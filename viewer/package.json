    "@tiptap/extension-table-row": "^2.0.0",
    "@tiptap/extension-task-item": "^2.0.0",
    "@tiptap/extension-task-list": "^2.0.0",
    "@tiptap/pm": "^2.0.0",
    "@tiptap/react": "^2.0.0",
    "@tiptap/starter-kit": "^2.0.0",
    "exceljs": "^4.4.0",
    "lowlight": "^3.1.0",
    "mcp-handler": "^1.1.0",
    "next": "15.5.27",
    "openai": "^6.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "jose": "6.2.3"
